# Copy to .env.local and fill in. These are read on the server only: never prefix
# them with NEXT_PUBLIC_ and never commit the real file.

# ── Contact form delivery (https://resend.com) ──────────────────────────────
# Until all three are set, the form tells visitors that online enquiries aren't
# switched on yet. It never pretends a message was sent.
RESEND_API_KEY=
# Inbox that receives enquiries
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "OrbiTech <enquiries@yourdomain.com>"
CONTACT_FROM_EMAIL=

# ── Optional ────────────────────────────────────────────────────────────────
# Public address of the site, used for canonical links, the sitemap and social
# previews. Defaults to the value in content/site.ts.
NEXT_PUBLIC_SITE_URL=

# For automated tests only: send enquiry emails to a local stand-in instead of Resend.
# RESEND_API_URL=http://127.0.0.1:4010/emails
