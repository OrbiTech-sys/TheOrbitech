# Copy to .env.local and fill in. Never commit the real file.

# ── Site address ────────────────────────────────────────────────────────────
# Public address of the site, used for canonical links, the sitemap, robots.txt,
# social previews and structured data. Set it in Vercel for Production and
# Preview. If it is missing or not an https address, the value in
# content/site.ts (https://theorbitechsolution.com) is used.
NEXT_PUBLIC_SITE_URL=https://theorbitechsolution.com

# ── Contact form delivery ───────────────────────────────────────────────────
# The contact form uses the SMTP settings below. The message is sent from the SMTP
# mailbox to this inbox, with the visitor as Reply-To. Defaults to subhan.orbitech@gmail.com.
CONTACT_TO_EMAIL=subhan.orbitech@gmail.com

# ── SMTP: demo email check and contact form ─────────────────────────────────
# Visitors confirm an email address with a 6-digit code before a demo opens, and the
# contact form is sent, through this mailbox. Until SMTP_HOST, SMTP_USER and SMTP_PASS
# are set the contact form and the demo check say they "aren't switched on yet".
# (Demo codes also need OTP_SECRET.)
SMTP_HOST=
# 587 (STARTTLS, default) or 465 (SSL)
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to visitors. Must be an address this SMTP account may send as,
# e.g. "The OrbiTech Solutions <msubhanbutt10@gmail.com>". Gmail needs an App Password.
SMTP_FROM=
# Who is told when someone opens a demo. Defaults to msubhanbutt10@gmail.com.
OWNER_EMAIL=msubhanbutt10@gmail.com
# Signs the verification cookies. At least 32 random characters, kept secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_SECRET=
