# Copy to .env.local and fill in. These are read on the server only: never prefix
# them with NEXT_PUBLIC_ and never commit the real file.

# ── Contact form delivery (https://resend.com) ──────────────────────────────
# Until all three are set, the form tells visitors that online enquiries aren't
# switched on yet. It never pretends a message was sent.
RESEND_API_KEY=
# Inbox that receives enquiries
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "OrbiTech <enquiries@yourdomain.com>"
CONTACT_FROM_EMAIL=

# ── Demo email check (SMTP) ─────────────────────────────────────────────────
# Visitors confirm an email address with a 6-digit code before a demo opens.
# Until SMTP_HOST, SMTP_USER, SMTP_PASS and OTP_SECRET are all set, the site says
# email confirmation "isn't switched on yet" and no demo can be opened.
SMTP_HOST=
# 587 (STARTTLS, default) or 465 (SSL)
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to visitors. Must be an address this SMTP account may send as,
# e.g. "OrbiTech <msubhanbutt10@gmail.com>". Gmail needs an App Password.
SMTP_FROM=
# Who is told when someone opens a demo. Defaults to msubhanbutt10@gmail.com.
OWNER_EMAIL=msubhanbutt10@gmail.com
# Signs the verification cookies. At least 32 random characters, kept secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# Public address of the site, used for canonical links, the sitemap and social
# previews. Defaults to the value in content/site.ts.
NEXT_PUBLIC_SITE_URL=

# For automated tests only: send enquiry emails to a local stand-in instead of Resend.
# RESEND_API_URL=http://127.0.0.1:4010/emails
