# Copy to .env.local and fill in. Never commit the real file.

# ── Site address ────────────────────────────────────────────────────────────
# Public address of the site, used for canonical links, the sitemap, robots.txt,
# social previews and structured data. Set it in Vercel for Production and
# Preview. If it is missing or not an https address, the value in
# content/site.ts (https://theorbitechsolution.com) is used.
NEXT_PUBLIC_SITE_URL=https://theorbitechsolution.com

# ── Contact form delivery (https://resend.com) ──────────────────────────────
# Read on the server only: never prefix these with NEXT_PUBLIC_.
# Until all three are set, the form tells visitors that online enquiries aren't
# switched on yet. It never pretends a message was sent.
RESEND_API_KEY=
# Inbox that receives enquiries
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "The OrbiTech Solutions <nova@theorbitechsolution.com>"
CONTACT_FROM_EMAIL=

# For automated tests only: send enquiry emails to a local stand-in instead of Resend.
# RESEND_API_URL=http://127.0.0.1:4010/emails
